# 复制本文件为 .env 后填入你自己的值：
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库（保护密钥）。

# ── LLM 提供商选择 ──────────────────────────────────────────
# gemini = Google AI Studio (默认)；dify = 原 Dify Webhook
LLM_PROVIDER=gemini

# ── Gemini (Google AI Studio) ───────────────────────────────
# 在 https://aistudio.google.com/app/apikey 获取 API Key 后填入下方
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT=120

# ── Dify（保留，切换 LLM_PROVIDER=dify 时使用）───────────────
# DIFY_API_KEY=
# DIFY_WEBHOOK_URL=
# DIFY_BASE_URL=https://api.dify.ai/v1
# DIFY_TIMEOUT=60
