# Copy this file to .env and fill in your values:
#   cp .env.example .env
# .env is ignored by git.

# LLM provider selection
# dify = primary workflow (default)
# gemini = DevOps / debugging mode on the approved machine only
LLM_PROVIDER=dify

# Dify primary workflow
# Configure the workflow that receives dataset metadata + user query and returns Python code.
DIFY_API_KEY=
DIFY_BASE_URL=https://ai-platform-uat.ey.net/v1
DIFY_TIMEOUT=60

# Dedicated Dify workflow for business-analysis indicator generation.
# The workflow receives one JSON paragraph input named request_payload and one
# optional document file-list input named reference_files.
DIFY_METRIC_API_KEY=
DIFY_METRIC_BASE_URL=https://ai-platform-uat.ey.net/v1
DIFY_METRIC_TIMEOUT=180

# Dedicated Dify workflow that validates a company name and returns legal-entity
# candidates before the indicator workflow starts.
DIFY_COMPANY_RESOLUTION_API_KEY=
DIFY_COMPANY_RESOLUTION_BASE_URL=https://ai-platform-uat.ey.net/v1
DIFY_COMPANY_RESOLUTION_TIMEOUT=60

# Analysis-experience workflow.
# This Dify app receives only a sanitized session_payload. It must perform the
# final Dify Knowledge write itself; do not place a Knowledge API key here.
# Its App API key and base URL are built into the client and are not user settings.
EXPERIENCE_LEARNING_ENABLED=true
DIFY_EXPERIENCE_TIMEOUT=120
EXPERIENCE_MAX_PAYLOAD_CHARS=40000
EXPERIENCE_TENANT_ID=ey-da-client
EXPERIENCE_PROJECT_ID=ey-intelligent-da-client
# EXPERIENCE_USER_ID=
# APP_VERSION=development
# ANALYSIS_WORKFLOW_VERSION=unspecified

# Local execution and large-dataset controls
EXEC_TIMEOUT_SEC=30
EXEC_MAX_MEM_MB=512
MAX_CODE_RETRIES=3
SAMPLE_ROWS_PER_SHEET=5000
LARGE_DATASET_ROWS=100000
LARGE_EXCEL_MB=20
MAX_DATASET_BYTES=1073741824
MAX_SELECTED_DATASETS=3
BACKGROUND_ANALYSIS_MB=100
BACKGROUND_ANALYSIS_ROWS=300000
BACKGROUND_EXEC_MAX_MEM_MB=4096
BACKGROUND_EXEC_TIMEOUT_SEC=3600

# DevOps mode
# These settings are for approved local debugging only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT=120
# GEMINI_THINKING_BUDGET=2048
# GEMINI_THINKING_LEVEL=low
# GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash,gemini-2.0-flash-lite
