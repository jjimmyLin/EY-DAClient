# Copy this file to .env and fill in your values:
#   cp .env.example .env
# .env is ignored by git.

# LLM provider selection
# dify = primary workflow (default)
# gemini = DevOps / debugging mode
# deepseek = optional fallback
LLM_PROVIDER=dify

# Dify primary workflow
# Configure the workflow that receives dataset metadata + user query and returns Python code.
DIFY_API_KEY=
DIFY_WEBHOOK_URL=
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_TIMEOUT=60

# Gemini (Google AI Studio) DevOps mode
# Get an API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT=120
# GEMINI_THINKING_BUDGET=2048
# GEMINI_THINKING_LEVEL=low
# GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash,gemini-2.0-flash-lite

# DeepSeek (optional)
# Set LLM_PROVIDER=deepseek to use it.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT=120
# DEEPSEEK_THINKING_ENABLED=true
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_STREAM=true
# DEEPSEEK_MODEL_FALLBACKS=deepseek-v4-flash,deepseek-v4-pro
