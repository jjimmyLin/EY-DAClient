# 复制本文件为 .env 后填入你自己的值：
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库（保护密钥）。

# ── LLM 提供商选择 ──────────────────────────────────────────
# gemini = Google AI Studio (默认)；dify = 原 Dify Webhook；deepseek = DeepSeek API
LLM_PROVIDER=gemini

# ── Gemini (Google AI Studio) ───────────────────────────────
# 在 https://aistudio.google.com/app/apikey 获取 API Key 后填入下方
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT=120
# GEMINI_THINKING_BUDGET=2048
# GEMINI_THINKING_LEVEL=low
# GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash,gemini-2.0-flash-lite

# ── DeepSeek（切换 LLM_PROVIDER=deepseek 时使用）────────────
# 在 https://platform.deepseek.com/api_keys 获取 API Key 后填入下方
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT=120
# DEEPSEEK_THINKING_ENABLED=true
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_STREAM=true
# DEEPSEEK_MODEL_FALLBACKS=deepseek-v4-flash,deepseek-v4-pro

# ── Dify（保留，切换 LLM_PROVIDER=dify 时使用）───────────────
# DIFY_API_KEY=
# DIFY_WEBHOOK_URL=
# DIFY_BASE_URL=https://api.dify.ai/v1
# DIFY_TIMEOUT=60
